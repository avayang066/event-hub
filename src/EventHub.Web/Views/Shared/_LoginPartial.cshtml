@using EventHub.Web.Data
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

<nav class="app-auth">
    @if (SignInManager.IsSignedIn(User))
    {
        <a class="btn btn-sm btn-link" asp-area="Identity" asp-page="/Account/Manage/Index">@User.Identity?.Name</a>
        <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout"
              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
            <button type="submit" class="btn btn-sm btn-outline-secondary">登出</button>
        </form>
    }
    else
    {
        <a class="btn btn-sm btn-link" asp-area="Identity" asp-page="/Account/Login">登入</a>
        <a class="btn btn-sm btn-primary" asp-area="Identity" asp-page="/Account/Register">註冊</a>
    }
</nav>
