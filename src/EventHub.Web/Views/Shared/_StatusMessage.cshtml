@* 顯示上一個動作的結果訊息（TempData，只顯示一次） *@
@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success alert-dismissible fade show py-2" role="status">
        @status
        <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="關閉"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
        @error
        <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="關閉"></button>
    </div>
}
