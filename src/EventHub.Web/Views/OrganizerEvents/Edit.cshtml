@using EventHub.Web.Data.Entities
@using EventHub.Web.Infrastructure
@model EventHub.Web.Models.Organizer.EventFormViewModel
@{
    ViewData["Title"] = "編輯活動";
}

<a class="back-link" asp-controller="Organizer" asp-action="Index">‹ 我的活動</a>

<div class="page-header">
    <div class="d-flex align-items-center gap-3">
        <h1 class="h3">編輯活動</h1>
        <span class="badge @Model.Status.ToBadgeClass()">@Model.Status.ToLabel()</span>
    </div>
    <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.Id">@(Model.Status == EventStatus.Draft ? "預覽活動頁" : "查看活動頁") ›</a>
</div>

<div class="detail-layout">
    @* ---------- 左：活動內容表單 ---------- *@
    <div class="panel">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" novalidate>
            <partial name="_EventForm" model="Model" />
        </form>
    </div>

    @* ---------- 右：狀態與動作 ---------- *@
    <aside class="detail-aside">
        <div class="panel">
            <div class="text-muted small">已報名</div>
            <div class="detail-price mb-3">@Model.ReservedCount <span class="fs-6 text-muted">/ @Model.Capacity 人</span></div>

            @switch (Model.Status)
            {
                case EventStatus.Draft:
                    <p class="small text-muted">草稿只有你看得到。確認內容後按「上架」開放報名。</p>
                    <form asp-action="Publish" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-success w-100">上架</button>
                    </form>
                    break;

                case EventStatus.Published:
                    if (Model.HasRegistrations)
                    {
                        <p class="small text-muted mb-0">已有人報名，不能下架；修改時間或地點後請自行通知報名者。</p>
                    }
                    else
                    {
                        <form asp-action="Unpublish" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="btn btn-outline-secondary w-100">下架（回到草稿）</button>
                        </form>
                    }
                    break;

                case EventStatus.Cancelled:
                    <p class="small text-muted mb-0">此活動已取消，無法再修改。</p>
                    break;
            }

            @if (Model.Status != EventStatus.Cancelled)
            {
                <hr class="my-4" />
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('確定要取消這個活動嗎？取消後無法復原。@(!Model.HasRegistrations ? "" : Model.Price > 0 ? $"已報名的 {Model.ReservedCount} 人需要另外處理退款。" : $"已報名的 {Model.ReservedCount} 人的報名將一併取消。")');">
                    <button type="submit" class="btn btn-outline-danger w-100">取消活動</button>
                </form>
            }
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
