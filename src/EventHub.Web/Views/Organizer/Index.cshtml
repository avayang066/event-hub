@using EventHub.Web.Data.Entities
@using EventHub.Web.Infrastructure
@model List<Event>
@{
    ViewData["Title"] = "我的活動";
    ViewData["PageWidth"] = "medium";
}

<div class="page-header">
    <h1 class="h3">我的活動</h1>
    <a class="btn btn-primary" asp-controller="OrganizerEvents" asp-action="Create">＋ 新增活動</a>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <p class="mb-3">還沒有活動。</p>
        <a class="btn btn-outline-primary" asp-controller="OrganizerEvents" asp-action="Create">建立第一個活動</a>
    </div>
}
else
{
    <ul class="event-list">
        @foreach (var e in Model)
        {
            <li>
                <a class="event-list-item" asp-controller="OrganizerEvents" asp-action="Edit" asp-route-id="@e.Id">
                    <div class="event-list-thumb">
                        @if (e.CoverImagePath is not null)
                        {
                            <img src="@e.CoverImagePath" alt="" loading="lazy" />
                        }
                    </div>
                    <div class="event-list-body">
                        <div class="d-flex align-items-start justify-content-between gap-2">
                            <span class="event-list-title">@e.Title</span>
                            <span class="badge @e.Status.ToBadgeClass()">@e.Status.ToLabel()</span>
                        </div>
                        <div class="small text-muted">@EventTimeFormatter.FormatDateTime(e.StartAt)</div>
                        <div class="small">
                            @e.Price.ToPriceLabel()
                            <span class="text-muted">・</span>
                            已報名 @e.ReservedCount / @e.Capacity
                        </div>
                    </div>
                </a>
            </li>
        }
    </ul>
}
