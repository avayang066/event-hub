@model EventHub.Web.Models.Payments.EcpayCheckoutForm
@{
    ViewData["Title"] = "前往付款";
    ViewData["PageWidth"] = "narrow";
}

<div class="panel text-center">
    <h1 class="h5 mb-2">正在前往綠界付款頁…</h1>
    <p class="text-muted small mb-4">若畫面沒有自動跳轉，請按下方按鈕。</p>

    @* 送往綠界的欄位都要算進檢查碼，不能多帶防偽權杖 *@
    <form id="ecpay-checkout" method="post" action="@Model.ActionUrl" asp-antiforgery="false">
        @foreach (var (name, value) in Model.Fields)
        {
            <input type="hidden" name="@name" value="@value" />
        }
        <button type="submit" class="btn btn-primary">前往綠界付款</button>
    </form>
</div>

@section Scripts {
    <script>document.getElementById('ecpay-checkout').submit();</script>
}
