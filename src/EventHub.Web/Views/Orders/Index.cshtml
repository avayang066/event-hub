@using EventHub.Web.Infrastructure
@using EventHub.Web.Services
@model List<EventHub.Web.Models.Orders.OrderListItemViewModel>
@{
    ViewData["Title"] = "我的報名";
}

<h1 class="h4 mb-3">我的報名</h1>

@if (Model.Count == 0)
{
    <div class="text-center text-muted py-5">
        <p class="mb-3">還沒有報名任何活動。</p>
        <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Index">去看看活動</a>
    </div>
}
else
{
    <ul class="list-unstyled event-list">
        @foreach (var o in Model)
        {
            <li>
                <a class="event-list-item" asp-action="Details" asp-route-orderNo="@o.OrderNo">
                    <div class="event-list-body">
                        <div class="d-flex align-items-start justify-content-between gap-2">
                            <span class="event-list-title">@o.EventTitle</span>
                            <span class="badge @o.Status.ToBadgeClass()">@o.Status.ToLabel()</span>
                        </div>
                        <div class="small text-muted">@EventTimeFormatter.FormatDateTime(o.EventStartAt)</div>
                        <div class="small">@o.Amount.ToPriceLabel()</div>
                    </div>
                </a>
            </li>
        }
    </ul>
}
