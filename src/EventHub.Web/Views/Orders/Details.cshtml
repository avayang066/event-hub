@using EventHub.Web.Infrastructure
@using EventHub.Web.Services
@model EventHub.Web.Models.Orders.OrderDetailViewModel
@{
    ViewData["Title"] = "報名明細";
    ViewData["PageWidth"] = "medium";
}

<a class="back-link" asp-action="Index">‹ 我的報名</a>

<div class="page-header">
    <div class="d-flex align-items-center gap-3">
        <h1 class="h3">報名明細</h1>
        <span class="badge @Model.Status.ToBadgeClass()">@Model.Status.ToLabel()</span>
    </div>
</div>

@switch (Model.Status)
{
    case OrderDisplayStatus.AwaitingPayment:
        <div class="alert alert-warning">
            名額保留至 <strong>@Model.ExpiresAt!.Value.ToString("HH:mm")</strong>，請在此之前完成付款，逾時名額將釋出。
        </div>
        break;
    case OrderDisplayStatus.PaymentExpired:
        <div class="alert alert-secondary">
            已超過付款期限，此筆報名將被取消。如仍想參加，請回活動頁重新報名。
        </div>
        break;
    case OrderDisplayStatus.Paid when Model.EventCancelled:
        <div class="alert alert-danger">活動已取消，平台將為你辦理退款。</div>
        break;
    case OrderDisplayStatus.Paid:
        <div class="alert alert-success">報名成功，活動當天見！</div>
        break;
    case OrderDisplayStatus.Cancelled when Model.EventCancelled:
        <div class="alert alert-secondary">活動已取消，此筆報名一併取消。</div>
        break;
    case OrderDisplayStatus.Refunded:
        <div class="alert alert-info">款項已退還，實際入帳時間依付款方式而定。</div>
        break;
}

@if (Model.IsAwaitingPayment)
{
    <div class="event-detail-action mb-4">
        <div>
            <div class="text-muted small">應付金額</div>
            <div class="detail-price">@Model.Amount.ToPriceLabel()</div>
        </div>
        @* TODO 第 5 步：送出綠界結帳 *@
        <button type="button" class="btn btn-primary btn-lg" disabled>付款功能即將開放</button>
    </div>
}

<div class="panel mb-4">
    <h2 class="section-title mt-0">活動</h2>
    <dl class="event-detail-info">
        <dt>活動</dt>
        <dd><a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId">@Model.EventTitle</a></dd>

        <dt>時間</dt>
        <dd>@EventTimeFormatter.FormatRange(Model.EventStartAt, Model.EventEndAt)</dd>

        <dt>地點</dt>
        <dd>@Model.EventLocation</dd>

        <dt>金額</dt>
        <dd>@Model.Amount.ToPriceLabel()</dd>
    </dl>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="panel h-100">
            <h2 class="section-title mt-0">報名資料</h2>
            <dl class="event-detail-info">
                <dt>姓名</dt>
                <dd>@Model.AttendeeName</dd>

                <dt>手機</dt>
                <dd>@Model.AttendeePhone</dd>

                <dt>Email</dt>
                <dd class="text-break">@Model.AttendeeEmail</dd>

                @if (Model.Note is not null)
                {
                    <dt>備註</dt>
                    <dd class="event-detail-description">@Model.Note</dd>
                }
            </dl>
        </div>
    </div>

    <div class="col-md-6">
        <div class="panel h-100">
            <h2 class="section-title mt-0">訂單資訊</h2>
            <dl class="event-detail-info">
                <dt>訂單編號</dt>
                <dd class="font-monospace">@Model.OrderNo</dd>

                <dt>報名時間</dt>
                <dd>@EventTimeFormatter.FormatDateTime(Model.CreatedAt)</dd>

                @if (Model.PaidAt is not null && Model.Amount > 0)
                {
                    <dt>付款時間</dt>
                    <dd>@EventTimeFormatter.FormatDateTime(Model.PaidAt.Value)</dd>
                }
                @if (Model.CancelledAt is not null)
                {
                    <dt>取消時間</dt>
                    <dd>@EventTimeFormatter.FormatDateTime(Model.CancelledAt.Value)</dd>
                }
                @if (Model.RefundedAt is not null)
                {
                    <dt>退款時間</dt>
                    <dd>@EventTimeFormatter.FormatDateTime(Model.RefundedAt.Value)</dd>
                }
            </dl>
        </div>
    </div>
</div>

<div class="mt-4 text-end">
    @if (Model.CanCancel)
    {
        <form asp-action="Cancel" asp-route-orderNo="@Model.OrderNo" method="post" class="d-inline"
              onsubmit="return confirm('確定要取消這筆報名嗎？名額將會釋出給其他人。');">
            <button type="submit" class="btn btn-outline-danger">取消報名</button>
        </form>
    }
    else if (Model.Status == OrderDisplayStatus.Paid && Model.Amount > 0 && !Model.EventCancelled)
    {
        <p class="small text-muted mb-0">已付款的報名無法自行取消，如需取消並退款，請聯絡主辦單位。</p>
    }
    else if (Model.Status == OrderDisplayStatus.Paid && Model.Amount == 0 && !Model.EventCancelled)
    {
        <p class="small text-muted mb-0">如無法參加，請聯絡主辦單位。</p>
    }
</div>
